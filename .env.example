AI_COMPAT_MODEL=your-model-id
AI_EXTERNAL_REVIEW_ENABLED=false
AI_REQUEST_TIMEOUT_SEC=90
AI_MAX_TOKENS=2048
AI_AUTO_REVIEW_ENABLED=false
AI_AUTO_REVIEW_EVERY_TRADES=5
